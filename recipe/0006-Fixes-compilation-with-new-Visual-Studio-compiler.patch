From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Tue, 23 Sep 2025 08:17:48 -0400
Subject: [PATCH 6/6] Fixes compilation with new Visual Studio compiler

xref: https://sourceforge.net/p/enblend/code/ci/993fd4822e8d8e19d019f4479a55170a7a611bb2/
---
 src/fixmath.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/fixmath.h b/src/fixmath.h
index f10333f..85c5a51 100644
--- a/src/fixmath.h
+++ b/src/fixmath.h
@@ -362,7 +362,11 @@ template <typename DestPixelType, typename PyramidPixelType, int PyramidIntegerB
 using ConvertPyramidToScalarFunctor =
 class SpecializedConvertPyramidToScalarFunctor
                       <DestPixelType, PyramidPixelType,
+#if defined _MSC_VER && _MSC_VER >= 1944
+                       std::is_integral_v<typename vigra::NumericTraits<PyramidPixelType>::ValueType>,
+#else
                        std::numeric_limits<typename vigra::NumericTraits<PyramidPixelType>::ValueType>::is_integer,
+#endif
                        PyramidIntegerBits, PyramidFractionBits>;
 
 
