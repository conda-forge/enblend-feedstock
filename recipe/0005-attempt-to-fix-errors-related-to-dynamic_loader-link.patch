From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Tue, 9 Sep 2025 13:11:44 -0400
Subject: [PATCH 5/6] attempt to fix errors related to dynamic_loader linking

---
 src/dynamic_loader/CMakeLists.txt | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/dynamic_loader/CMakeLists.txt b/src/dynamic_loader/CMakeLists.txt
index f06cd8e..c1f98ec 100644
--- a/src/dynamic_loader/CMakeLists.txt
+++ b/src/dynamic_loader/CMakeLists.txt
@@ -23,3 +23,11 @@ else()
   endif()
 endif()
 add_library(dynamic_loader STATIC ${DYNAMIC_LOADER_FILES})
+
+# Link against libdl when using POSIX dynamic loading
+if(HAVE_DL AND NOT WIN32)
+  find_library(DL_LIBRARY dl)
+  if(DL_LIBRARY)
+    target_link_libraries(dynamic_loader ${DL_LIBRARY})
+  endif()
+endif()
